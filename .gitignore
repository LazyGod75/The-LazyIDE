# LazyBrain dev brain (local only, not committed)
.lazybrain/
# Agent worktrees (managed by lazy agent pipeline)
.lazy/worktrees/
# Internalized LazyBrain engine (engine/) â€” vendored source lives under
# version control, but its build artifacts do not. Already covered by the
# generic `node_modules` / `dist` rules above; listed explicitly so the
# self-contained engine's ignore policy is documented at the point of intent.
engine/node_modules/
engine/dist/
# Bundled sidecar resources
# node.exe is large (66 MB) â€” downloaded in CI via `npm run bundle:node-exe`, not committed.
# lazybrain/ is vendored into the repo so CI is self-contained; see RELEASING.md.
src-tauri/resources/node.exe
# Un-ignore the vendored lazybrain bundle (overrides the `node_modules` rule above).
# The lazybrain node_modules are intentionally committed so CI needs no external repo.
!src-tauri/resources/lazybrain/
!src-tauri/resources/lazybrain/**
# Secrets â€” never commit
.env
.env.*
!.env.example
!cloud/.env.example
supabase/.env
supabase/.temp/
.tauri/
**/lazy.key
wrangler.toml
r2.env
