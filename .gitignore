/scratch/

# ---------------------------------------------------------------------------
# Root-level ad-hoc scripts, logs, and analysis exports
#
# Manual QA/verification work drops throwaway scripts, PowerShell helpers,
# and debug captures directly at the repo root. All patterns below are
# root-anchored (leading "/") so they never shadow legitimately-named files
# living under scripts/, e2e/, or src/.
# Ad-hoc debug/test scripts at repo root (_final-test.mjs, _qa-driver.mjs,
# _retest.mjs, _reverify.mjs, _v1-mission-test.mjs, _v2-gate-test.mjs, ...)
/_*.mjs
# Ad-hoc Playwright scripts at repo root without an underscore prefix
/playwright-*.mjs
# Any other "*-test.mjs" throwaway script at repo root
/*-test.mjs
# Debug output logs from ad-hoc scripts at repo root (_tauri-dev-err.log,
# _preview.err.log, ...)
/_*.log
# PowerShell crop/screenshot helper scripts at repo root
/*.ps1
# One-off PNG analysis exports at repo root
# (CONTINUE-ANALYSIS.html itself now lives tracked under docs/archive/)
/e2e-desktop-final.png
# One-off vitest console dump at repo root (mo-test.txt, ...)
/mo-*.txt
# Transient Playwright timestamp files (generated by e2e/vite-web.config.ts)
*.timestamp-*.mjs
# Ad-hoc E2E screenshot dumps and driver state files at repo root
# (_e2e-shots/ holds hundreds of throwaway captures; _e2e-state.json,
# _newuser-state.json, _fix9-state.json, _e2e-cmd.json are transient driver
# scratch â€” none belong in a reproducible release state).
/_e2e-shots/
/_*-shots/
/_*.json
# Agent / mission local state
.lazy/
.claude/worktrees/
_mission/
# Subagent-driven-development scratch (ledger, briefs, reports)
.superpowers/
# crash artifacts
*.stackdump
# local dev launcher configs
.claude/launch.json

