{
  "name": "lazybrain-teams",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-user enterprise layer on top of the LazyBrain memory engine — teams, permissions, shared brains, governance.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "build": "esbuild src/server/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server/main.js --packages=external",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests scripts",
    "format": "biome format --write src tests scripts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-demo.ts --fresh",
    "demo": "tsx scripts/seed-demo.ts --fresh --start"
  },
  "dependencies": {
    "lazybrain": "file:.."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
