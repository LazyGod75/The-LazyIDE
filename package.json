{
  "name": "lazy-ide",
  "private": true,
  "version": "0.1.19",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "bin": {
    "lazy": "dist/cli/lazy.cjs"
  },
  "scripts": {
    "dev": "vite",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/setup.mjs --dev",
    "typecheck": "tsc -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:idebench": "node scripts/build-idebench.mjs",
    "typecheck:cli": "tsc -p tsconfig.cli.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:cli",
    "lazy": "node dist/cli/lazy.cjs",
    "lint": "eslint . --max-warnings 999",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:sidecar": "node scripts/bundle-lazybrain.mjs",
    "bundle:node-exe": "node scripts/fetch-node-exe.mjs",
    "bundle:all": "npm run bundle:node-exe && npm run bundle:sidecar",
    "tauri:build": "npm run bundle:sidecar && tauri build",
    "test:e2e": "playwright test",
    "demo:record": "node scripts/record-demo.mjs",
    "test:rails-live": "node scripts/eval-rails-live.mjs",
    "bench:claude-ab": "node bench/claude-ab.mjs",
    "verify": "node scripts/verify.mjs",
    "secrets:check": "node scripts/guard-secrets.mjs",
    "export:public": "node scripts/export-public-repo.mjs",
    "export:public:dry": "node scripts/export-public-repo.mjs --dry-run",
    "hooks:install": "node scripts/install-secret-guard.mjs",
    "prepare": "node scripts/install-secret-guard.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/merge": "^6.7.0",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@novnc/novnc": "^1.7.0",
    "@solarisdk/browser": "0.1.1",
    "@solarisdk/desktop": "0.1.2",
    "@solarisdk/sandbox": "0.1.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "3d-force-graph": "^1.80.0",
    "commander": "^15.0.0",
    "elkjs": "^0.11.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.11",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.21.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gifenc": "^1.0.3",
    "globals": "^17.6.0",
    "jsdom": "^24.1.3",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
