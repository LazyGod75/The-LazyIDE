{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "os:allow-locale",
    "updater:default",
    "process:allow-restart",
    "shell:allow-open"
  ]
}
